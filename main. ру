@app.post("/api/admin/login")
async def admin_login(req: AdminLoginReq):
    if not ADMIN_PASSWORD or req.password != ADMIN_PASSWORD:
        raise HTTPException(403, "Неверный пароль")
    t = secrets.token_urlsafe(32)
    ADMIN_TOKENS.add(t)
    return {"admin_token": t}


@app.get("/api/admin/users")
async def admin_users(admin_token: str):
    check_admin(admin_token)
    async with SessionLocal() as s:
        res = await s.execute(select(User).order_by(desc(User.created_at)).limit(500))
        users = res.scalars().all()
    return [
        {
            "id": u.id, "phone": u.phone, "nick": u.nick,
            "room": u.room, "is_banned": u.is_banned,
            "created_at": u.created_at,
        }
        for u in users
    ]


@app.get("/api/admin/messages")
async def admin_messages(admin_token: str, limit: int = 200):
    check_admin(admin_token)
    limit = min(max(1, limit), 500)
    async with SessionLocal() as s:
        res = await s.execute(
            select(Message).order_by(desc(Message.created_at)).limit(limit)
        )
        rows = res.scalars().all()
    return [
