def _build_engine():
    if not DATABASE_URL_RAW:
        print(">>> Использую локальный SQLite: chat.db", flush=True)
        return create_async_engine("sqlite+aiosqlite:///./chat.db", echo=False)

    url = DATABASE_URL_RAW

    # Убираем все query-параметры (?sslmode=require и т.п.)
    # Neon требует SSL — передадим его отдельно через connect_args
    if "?" in url:
        url = url.split("?", 1)[0]

    # Приводим схему к asyncpg
    if url.startswith("postgres://"):
        url = "postgresql+asyncpg://" + url[len("postgres://"):]
    elif url.startswith("postgresql://"):
        url = "postgresql+asyncpg://" + url[len("postgresql://"):]
    elif not url.startswith("postgresql+asyncpg://"):
        url = "postgresql+asyncpg://" + url

    print(f">>> Подключаюсь к PostgreSQL: {url.split('@')[-1]}", flush=True)

    return create_async_engine(
        url,
        connect_args={"ssl": True},
        pool_pre_ping=True,
        pool_recycle=1800,
        echo=False,
    )


engine = _build_engine()
SessionLocal = async_sessionmaker(engine, expire_on_commit=False)


class Base(DeclarativeBase):
    pass


class User(Base):
    __tablename__ = "users"
    id: Mapped[int] = mapped_column(Integer, primary_key=True, autoincrement=True)
    phone: Mapped[str] = mapped_column(String(20), unique=True, index=True)
    nick: Mapped[str] = mapped_column(String(50))
    token: Mapped[str] = mapped_column(String(80), unique=True, index=True)
    room: Mapped[str] = mapped_column(String(30), default="general")
    is_banned: Mapped[bool] = mapped_column(Boolean, default=False)
    created_at: Mapped[int] = mapped_column(BigInteger)


class Message(Base):
    __tablename__ = "messages"
    id: Mapped[int] = mapped_column(Integer, primary_key=True, autoincrement=True)
    user_id: Mapped[int] = mapped_column(ForeignKey("users.id"))
