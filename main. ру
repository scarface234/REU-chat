def now_ms() -> int:
    return int(time.time() * 1000)


def normalize_phone(raw: str) -> str:
    return re.sub(r"\D", "", raw or "")


def generate_nick() -> str:
    return f"{secrets.choice(ADJECTIVES)} {secrets.choice(NOUNS)}"


def filter_text(text: str) -> str:
    if not BANNED_WORDS:
        return text
    pat = re.compile("|".join(re.escape(w) for w in BANNED_WORDS), re.IGNORECASE)
    return pat.sub(REPLACEMENT, text)


# ============================================================
#   LIFESPAN
# ============================================================
@asynccontextmanager
async def lifespan(app: FastAPI):
    try:
        await init_db()
    except Exception as e:
        print(f">>> ОШИБКА при инициализации БД: {e}", flush=True)
        traceback.print_exc()
        raise
    yield


app = FastAPI(title="РЭУ Чат", lifespan=lifespan)


