@app.websocket("/ws")
async def ws_endpoint(websocket: WebSocket, token: str = ""):
    user = await get_user_by_token(token)
    if user is None:
        await websocket.close(code=4001)
        return
    if user.is_banned:
        await websocket.close(code=4002)
        return

    await manager.connect(user.id, websocket, user.room)

    try:
        while True:
            data = await websocket.receive_json()
            text = (data.get("text") or "").strip()
            if not text:
                continue

            async with SessionLocal() as s:
                res = await s.execute(select(User).where(User.id == user.id))
                fresh = res.scalar_one_or_none()
                if fresh is None or fresh.is_banned:
                    await websocket.close(code=4002)
                    manager.disconnect(user.id)
                    return
                current_room = fresh.room
                current_nick = fresh.nick

            text = filter_text(text)[:MAX_MESSAGE_LEN]
            ts = now_ms()

            async with SessionLocal() as s:
                s.add(Message(
                    user_id=user.id,
                    phone=user.phone,
                    nick=current_nick,
                    room=current_room,
                    text=text,
                    created_at=ts,
                ))
                await s.commit()

            await manager.broadcast_room(current_room, {
                "type": "message",
                "data": {
                    "phone": user.phone,
                    "nick": current_nick,
                    "room": current_room,
                    "text": text,
                    "time": ts,
                },
            })
    except WebSocketDisconnect:
        manager.disconnect(user.id)
    except Exception:
        manager.disconnect(user.id)


