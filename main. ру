@app.post("/api/login")
async def login(req: LoginReq):
    phone = normalize_phone(req.phone)
    if not (10 <= len(phone) <= 15):
        raise HTTPException(400, "Некорректный номер телефона")

    async with SessionLocal() as s:
        res = await s.execute(select(User).where(User.phone == phone))
        user = res.scalar_one_or_none()

        if user is None:
            user = User(
                phone=phone,
                nick=generate_nick(),
                token=secrets.token_urlsafe(40),
                room="general",
                is_banned=False,
                created_at=now_ms(),
            )
            s.add(user)
            await s.commit()
            await s.refresh(user)

        if user.is_banned:
            raise HTTPException(403, "Ваш номер заблокирован администратором")

        return {
            "token": user.token,
            "phone": user.phone,
            "nick": user.nick,
            "room": user.room,
        }


@app.get("/api/rooms")
async def rooms():
    return [{"id": k, "title": v} for k, v in ROOMS.items()]


@app.post("/api/room")
async def set_room(req: RoomReq):
    if req.room not in ROOMS:
        raise HTTPException(400, "Неизвестная комната")
    async with SessionLocal() as s:
        res = await s.execute(select(User).where(User.token == req.token))
        user = res.scalar_one_or_none()
        if user is None:
            raise HTTPException(401, "Не авторизован")
        user.room = req.room
        await s.commit()
        manager.set_room(user.id, req.room)
        return {"room": user.room}


@app.get("/api/messages")
async def get_messages(room: str = "general", limit: int = HISTORY_LIMIT):
    if room not in ROOMS:
        raise HTTPException(400, "Неизвестная комната")
    limit = min(max(1, limit), 500)
    async with SessionLocal() as s:
        res = await s.execute(
            select(Message)
            .where(Message.room == room)
            .order_by(desc(Message.created_at))
            .limit(limit)
        )
        rows = res.scalars().all()
    rows.reverse()
    return [
        {"phone": m.phone, "nick": m.nick, "text": m.text, "time": m.created_at}
        for m in rows
    ]


