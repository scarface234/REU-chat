@app.post("/api/admin/ban")
async def admin_ban(req: BanReq):
    check_admin(req.admin_token)
    async with SessionLocal() as s:
        res = await s.execute(select(User).where(User.id == req.user_id))
        user = res.scalar_one_or_none()
        if user is None:
            raise HTTPException(404, "Пользователь не найден")
        user.is_banned = req.banned
        await s.commit()

    if req.banned:
        await manager.force_disconnect(req.user_id, code=4002)

    return {"ok": True, "banned": req.banned}


@app.post("/api/admin/delete_message")
async def admin_delete_msg(req: DeleteMsgReq):
    check_admin(req.admin_token)
    async with SessionLocal() as s:
        await s.execute(delete(Message).where(Message.id == req.message_id))
        await s.commit()
    return {"ok": True}


