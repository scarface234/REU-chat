  const cur = state.rooms.find(r => r.id === state.room);
  roomLabel.textContent = cur ? 'Комната: ' + cur.title : 'Анонимный чат';
}
async function loadMessages() {
  const res = await fetch('/api/messages?room=' + encodeURIComponent(state.room));
  const data = await res.json();
  renderAll(data);
  scrollBottom();
}
function connectWS() {
  const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
  const url = proto + '//' + location.host + '/ws?token=' + encodeURIComponent(state.token);
  const ws = new WebSocket(url);
  state.ws = ws;
  ws.onopen = () => { sendBtn.disabled = false; };
  ws.onmessage = e => {
    let msg; try { msg = JSON.parse(e.data); } catch { return; }
    if (msg.type === 'message' && msg.data.room === state.room) {
      appendMsg(msg.data); scrollBottom();
    }
  };
  ws.onclose = e => {
    sendBtn.disabled = true;
    if (e.code === 4001) { logout(); return; }
    if (e.code === 4002) {
      alert('Ваш аккаунт заблокирован администратором');
      logout(); return;
    }
    if (state.token) setTimeout(connectWS, 2000);
  };
}
async function switchRoom(room) {
  if (room === state.room) return;
  state.room = room;
  localStorage.setItem('reu_room', room);
  await fetch('/api/room', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ token: state.token, room }),
  });
  if (state.ws) { try { state.ws.close(1000); } catch(e) {} state.ws = null; }
  renderRoomsBar();
  await loadMessages();
  connectWS();
}
loginBtn.onclick = async () => {
  const raw = phoneInput.value.trim();
  if (!raw) { errorMsg.textContent = 'Введите номер'; return; }
  loginBtn.disabled = true; errorMsg.textContent = '';
  try {
    const res = await fetch('/api/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ phone: raw }),
    });
    const data = await res.json();
    if (!res.ok) { errorMsg.textContent = data.detail || 'Ошибка входа'; return; }
    state.token = data.token; state.phone = data.phone;
    state.nick = data.nick; state.room = data.room || 'general';
    localStorage.setItem('reu_token', state.token);
    localStorage.setItem('reu_phone', state.phone);
    localStorage.setItem('reu_nick',  state.nick);
    localStorage.setItem('reu_room',  state.room);
    showChat();
    await loadRooms();
    await loadMessages();
    connectWS();
  } catch (err) {
    errorMsg.textContent = 'Сервер недоступен';
  } finally { loginBtn.disabled = false; }
};
phoneInput.onkeydown = e => { if (e.key === 'Enter') loginBtn.click(); };
function logout() {
  if (state.ws) { try { state.ws.close(1000); } catch(e) {} state.ws = null; }
  ['reu_token','reu_phone','reu_nick','reu_room'].forEach(k => localStorage.removeItem(k));
  state.token = state.phone = state.nick = null;
  state.room = 'general';
  phoneInput.value = '';
  showAuth();
}
logoutBtn.onclick = logout;
function send() {
  const text = msgInput.value.trim();
  if (!text || !state.ws || state.ws.readyState !== WebSocket.OPEN) return;
  state.ws.send(JSON.stringify({ text }));
  msgInput.value = '';
}
sendBtn.onclick = send;
msgInput.onkeydown = e => { if (e.key === 'Enter') send(); };
(async function init() {
  await loadRooms();
  if (state.token && state.phone && state.nick) {
    showChat();
    await loadMessages();
    connectWS();
  } else { showAuth(); }
})();
</script>
</body>
</html>
"""


