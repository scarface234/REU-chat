class Manager:
    def __init__(self):
        self.conns: dict[int, tuple[WebSocket, str]] = {}

    async def connect(self, user_id: int, ws: WebSocket, room: str):
        await ws.accept()
        old = self.conns.get(user_id)
        if old is not None:
            try:
                await old[0].close(code=4000)
            except Exception:
                pass
        self.conns[user_id] = (ws, room)

    def disconnect(self, user_id: int):
        self.conns.pop(user_id, None)

    def set_room(self, user_id: int, room: str):
        if user_id in self.conns:
            ws, _ = self.conns[user_id]
            self.conns[user_id] = (ws, room)

    async def broadcast_room(self, room: str, payload: dict):
        dead = []
        for uid, (ws, r) in list(self.conns.items()):
            if r != room:
                continue
            try:
                await ws.send_json(payload)
            except Exception:
                dead.append(uid)
        for uid in dead:
            self.conns.pop(uid, None)

    async def force_disconnect(self, user_id: int, code: int = 4001):
        entry = self.conns.pop(user_id, None)
        if entry:
            try:
                await entry[0].close(code=code)
            except Exception:
                pass


